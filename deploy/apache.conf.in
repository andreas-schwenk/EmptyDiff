# EmptyDiff: Apache configuration (generated by install.sh from deploy/apache.conf.in; changes are lost on
# the next update - settings belong in /etc/emptydiff/config.toml).

# mode: https

# Certificate via mod_md (ACME, e.g. Let's Encrypt). The server must be reachable on ports 80 and 443.
MDomain @HOST@
MDContactEmail @ADMIN_EMAIL@
MDCertificateAgreement @MD_AGREEMENT@
MDRequireHttps temporary

<VirtualHost *:80>
    ServerName @HOST@
    # mod_md answers the ACME challenges and redirects everything else to https
</VirtualHost>

<VirtualHost *:443>
    ServerName @HOST@
    SSLEngine on
    ServerSignature Off

    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Robots-Tag "noindex, nofollow"

@VHOST_BODY@
</VirtualHost>
