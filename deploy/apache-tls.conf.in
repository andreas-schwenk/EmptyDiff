# EmptyDiff: Apache configuration with a certificate of the operator
# (generated by install.sh from deploy/apache-tls.conf.in when
# tls.certificate_file and tls.key_file are set in
# /etc/emptydiff/config.toml; changes are lost on the next update).
#
# For a server that cannot use mod_md (not reachable from the internet)
# but has a certificate from a certificate authority of its institution.
# Renewing the certificate means replacing the two files and running
# `systemctl reload apache2`.

# mode: tls

<VirtualHost *:80>
    ServerName @HOST@
    ServerSignature Off
    Redirect permanent / https://@HOST@/
</VirtualHost>

<VirtualHost *:443>
    ServerName @HOST@
    SSLEngine on
    SSLCertificateFile @CERT_FILE@
    SSLCertificateKeyFile @KEY_FILE@
    ServerSignature Off

    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Robots-Tag "noindex, nofollow"

@VHOST_BODY@
</VirtualHost>
