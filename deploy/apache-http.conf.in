# EmptyDiff: Apache configuration for plain HTTP (generated by install.sh
# from deploy/apache-http.conf.in when base_url starts with http://;
# changes are lost on the next update - settings belong in
# /etc/emptydiff/config.toml).
#
# Only for closed, trusted networks (a test server, an intranet): login
# codes and session cookies travel unencrypted. There is no certificate
# and no redirect to https.

# mode: http

<VirtualHost *:80>
    ServerName @HOST@
    ServerSignature Off

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Robots-Tag "noindex, nofollow"

@VHOST_BODY@
</VirtualHost>
