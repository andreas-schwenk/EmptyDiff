[Unit]
Description=EmptyDiff: delete expired submissions and login data

[Service]
Type=oneshot
User=emptydiff
Group=emptydiff
WorkingDirectory=@APP_DIR@
Environment=PYTHONPATH=@APP_DIR@
ExecStart=/usr/bin/python3 -m emptydiff purge
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
