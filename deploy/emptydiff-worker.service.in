[Unit]
Description=EmptyDiff worker (grading of submissions)
After=network.target
RequiresMountsFor=@DATA_DIR@/run

[Service]
Type=simple
User=emptydiff
Group=emptydiff
WorkingDirectory=@APP_DIR@
Environment=PYTHONPATH=@APP_DIR@
ExecStart=/usr/bin/python3 -m emptydiff worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
# Student programs run below this service. These limits cover the service as a whole (the limits of the sandbox
# apply to every single process): a program that multiplies itself or eats memory is stopped here and does not
# take the web server or the database with it. Adjust to the size of the server.
MemoryMax=2G
MemorySwapMax=0
TasksMax=200
# the worker needs no network (the sandbox has none either)
PrivateNetwork=yes

[Install]
WantedBy=multi-user.target
