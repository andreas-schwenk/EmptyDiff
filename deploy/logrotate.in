# EmptyDiff: Apache access and error logs contain IP addresses and are deleted after
# privacy.log_days days (generated by install.sh from deploy/logrotate.in).
/var/log/apache2/emptydiff/*.log {
    daily
    rotate @LOG_DAYS@
    maxage @LOG_DAYS@
    missingok
    notifempty
    nocompress
    create 640 root adm
    sharedscripts
    postrotate
        if invoke-rc.d apache2 status > /dev/null 2>&1; then
            invoke-rc.d apache2 reload > /dev/null 2>&1
        fi
    endscript
}
