# EmptyDiff: directives shared by both Apache variants (https and plain
# http); deploy.py inserts this file into apache.conf.in or
# apache-http.conf.in at @VHOST_BODY@. It is not installed by itself.
    # Upload size: the application's upper limit plus room for the multipart overhead
    LimitRequestBody @MAX_BODY@
    # Restoring a backup (admins only): larger files allowed
    <Location "/admin/backup/upload">
        LimitRequestBody @MAX_BACKUP_BODY@
    </Location>

    WSGIDaemonProcess emptydiff user=emptydiff group=emptydiff processes=2 threads=4 python-path=@APP_DIR@ display-name=%{GROUP}
    WSGIProcessGroup emptydiff
    WSGIScriptAlias / @APP_DIR@/emptydiff/wsgi.py

    <Directory @APP_DIR@/emptydiff>
        <Files wsgi.py>
            Require all granted
        </Files>
    </Directory>

    # Static files directly from Apache
    Alias /static/ @APP_DIR@/emptydiff/static/
    <Directory @APP_DIR@/emptydiff/static>
        Require all granted
        Header set Cache-Control "public, max-age=3600"
    </Directory>

    # Own logs (IP addresses): retention see /etc/logrotate.d/emptydiff and privacy.log_days
    ErrorLog /var/log/apache2/emptydiff/error.log
    CustomLog /var/log/apache2/emptydiff/access.log combined
