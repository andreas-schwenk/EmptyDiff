# EmptyDiff: Apache configuration behind a reverse proxy (generated by
# install.sh from deploy/apache-proxy.conf.in when proxy.addresses is
# set in /etc/emptydiff/config.toml; changes are lost on the next update).
#
# TLS ends at the proxy, which may serve the system under a path of its
# own site (the path of base_url, for example /lab). This server speaks
# plain http on port 80 and answers only the proxy. Keep the firewall
# of this machine closed for everyone else as well.

# mode: proxy

<VirtualHost *:80>
    ServerName @HOST@
    ServerSignature Off

    <Location "/">
        Require ip @PROXY_ADDRESSES@
    </Location>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Robots-Tag "noindex, nofollow"

@VHOST_BODY@
</VirtualHost>
